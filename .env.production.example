# MongoDB Configuration
# Configure no painel de deploy; não versione credenciais reais.
# Exemplo de host externo com autenticação administrativa:
MONGODB_URI=mongodb://usuario:senha@mongodb.example.com:27017/?authSource=admin&directConnection=true

# RabbitMQ Configuration — configure a URI real somente no ambiente de deploy.
RABBITMQ_URL=amqp://usuario:senha@rabbitmq.mirandasoft.com.br:5672/msoft
# Ativa o consumidor idempotente da fila msoft-form-client.
CLIENT_FORM_CONSUMER_ENABLED=true

# Server Configuration
PORT=3000
NODE_ENV=production
HOSTNAME=0.0.0.0

# Opcional: Configurações adicionais
# LOG_LEVEL=info
# MAX_POOL_SIZE=10
# MIN_POOL_SIZE=2

# S3 Storage (MinIO)
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=https://s3.mirandasoft.com.br
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_BUCKET=m-manage

# Redis Configs Updated
REDIS_PORT=6379
REDIS_PASSWORD=3h8328238390h
REDIS_URL="redis://redis.mirandasoft.com.br:54321/0"
REDIS_HOST=redis-production
CACHE_HANDLER=predis

# RabbitMQ Configs
RABBITMQ_URL="amqp://msoft_admin:q.%7DKVbWN%3A0w%7D@rabbitmq_production:5672/msoft"
CLIENT_FORM_CONSUMER_ENABLED=true
